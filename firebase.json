{
    "hosting": [
        {
            "target": "mkr-safety",
            "public": "artifacts/mkr-safety/dist/public",
            "cleanUrls": true,
            "ignore": [
                "firebase.json",
                "**/.*",
                "!**/.well-known/**",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "**/assets/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                },
                {
                    "source": "/index.html",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "/blog",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                },
                {
                    "source": "/blog/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                }
            ],
            "redirects": [
                {
                    "source": "/blog/balcony-safety-net-alternative-2",
                    "destination": "/blog/balcony-safety-net-alternative",
                    "type": 301
                },
                {
                    "source": "/blog/balcony-safety-net-alternative-3",
                    "destination": "/blog/balcony-safety-net-alternative",
                    "type": 301
                },
                {
                    "source": "/blog/balcony-safety-net-alternative-4",
                    "destination": "/blog/balcony-safety-net-alternative",
                    "type": 301
                },
                {
                    "source": "/blog/invisible-grill-cost-bangalore-2",
                    "destination": "/blog/invisible-grill-cost-bangalore",
                    "type": 301
                },
                {
                    "source": "/blog/invisible-grill-cost-bangalore-3",
                    "destination": "/blog/invisible-grill-cost-bangalore",
                    "type": 301
                },
                {
                    "source": "/blog/invisible-grill-vs-iron-grill-2",
                    "destination": "/blog/invisible-grill-vs-iron-grill",
                    "type": 301
                },
                {
                    "source": "/blog/pet-safety-balcony-grill-2",
                    "destination": "/blog/pet-safety-balcony-grill",
                    "type": 301
                },
                {
                    "source": "/blog/pet-safety-balcony-grill-3",
                    "destination": "/blog/pet-safety-balcony-grill",
                    "type": 301
                },
                {
                    "source": "/blog/window-safety-grill-for-apartments-2",
                    "destination": "/blog/window-safety-grill-for-apartments",
                    "type": 301
                }
            ]
        }
    ]
}
